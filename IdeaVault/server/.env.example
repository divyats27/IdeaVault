# Port the API will run on
PORT=5000

# Local MongoDB:
#   mongodb://127.0.0.1:27017/ideavault
# MongoDB Atlas (cloud) - paste your own connection string and add the DB name:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ideavault?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Any long random text. Used to sign login tokens. Keep it secret.
JWT_SECRET=your_secret_key
